# Public site URL, used for metadataBase, canonical URLs and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=https://www.uptimemarketing.com

# Google Analytics 4 measurement ID.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend API key, used to send contact form submissions.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact form submissions.
CONTACT_EMAIL_TO=hello@uptimemarketing.com

# WhatsApp number in international format (no + or spaces), used to build wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567
